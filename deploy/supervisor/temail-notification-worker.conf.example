; Dedicated system-notification worker. This queue never carries user outbound mail.
[program:temail-notification-worker]
directory=<PROJECT_PATH>
command=<PHP_BINARY> artisan queue:work <QUEUE_CONNECTION> --queue=notifications --sleep=<SLEEP_SECONDS> --tries=3 --timeout=<JOB_TIMEOUT_SECONDS> --backoff=30 --memory=<MEMORY_MB>
process_name=%(program_name)s_%(process_num)02d
numprocs=<NOTIFICATION_WORKER_COUNT>
user=<DEPLOYMENT_USER>
autostart=true
autorestart=true
startsecs=5
stopasgroup=true
killasgroup=true
stopsignal=TERM
stopwaitsecs=<GRACEFUL_STOP_WAIT_SECONDS>
redirect_stderr=false
stdout_logfile=<LOG_DIRECTORY>/notification-worker-%(process_num)02d.log
stderr_logfile=<LOG_DIRECTORY>/notification-worker-%(process_num)02d.error.log
stdout_logfile_maxbytes=<LOG_MAX_BYTES>
stdout_logfile_backups=<LOG_BACKUPS>
stderr_logfile_maxbytes=<LOG_MAX_BYTES>
stderr_logfile_backups=<LOG_BACKUPS>
