APP_NAME="TEmail Process Verification"
APP_ENV=local
APP_KEY=<GENERATE_A_LOCAL_VERIFICATION_KEY>
APP_DEBUG=false
APP_URL=http://127.0.0.1:18080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=<ISOLATED_TEST_DATABASE_DRIVER>
DB_HOST=<ISOLATED_TEST_DATABASE_HOST>
DB_PORT=<ISOLATED_TEST_DATABASE_PORT>
DB_DATABASE=<ISOLATED_TEST_DATABASE_NAME>
DB_USERNAME=<ISOLATED_TEST_DATABASE_USER>
DB_PASSWORD=<ISOLATED_TEST_DATABASE_PASSWORD>

QUEUE_CONNECTION=redis
QUEUE_DEFAULT=process-verification
QUEUE_WORKER_COUNT=2
QUEUE_WORKER_TIMEOUT=110
QUEUE_WORKER_TRIES=3
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
CACHE_PREFIX=temail_process_verification_<UNIQUE_NAMESPACE>
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6389
# Native/WSL alternative: use REDIS_PORT=6379 only with an isolated local Redis.
# Select exactly one endpoint; never point this profile at shared or production Redis.
REDIS_DB=<ISOLATED_REDIS_DATABASE_INDEX>
REDIS_CACHE_DB=<ISOLATED_REDIS_DATABASE_INDEX>
REDIS_QUEUE_DB=<ISOLATED_REDIS_DATABASE_INDEX>

PROCESS_INSTANCE_ID=<UNIQUE_LOCAL_VERIFICATION_INSTANCE>
PROCESS_HEARTBEAT_TTL_SECONDS=180
PROCESS_HEARTBEAT_WRITE_INTERVAL_SECONDS=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS=verification@example.invalid
MAIL_FROM_NAME="TEmail Verification"
SESSION_DRIVER=array
FILESYSTEM_DISK=local
